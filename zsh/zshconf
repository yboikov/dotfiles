kubectl() {
  if [[ "$1" = ns ]]; then
    shift
    FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --query '!openshift- !kube '" command kubectl ns "$@"
  else
    command kubectl "$@"
  fi
}

